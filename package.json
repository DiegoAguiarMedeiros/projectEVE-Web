    "@mui/icons-material": "^7.0.0",
    "@mui/lab": "^7.0.0",
    "@mui/material": "^7.3.11",
    "@mui/x-date-pickers": "^7.27.3",
    "@tanstack/react-query": "^5.101.2",
    "apexcharts": "^5.16.0",
    "axios": "^1.7.9",
    "dayjs": "^1.11.21",
